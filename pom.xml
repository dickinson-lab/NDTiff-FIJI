<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>40.0.0</version>
		<relativePath />
	</parent>
	
	<groupId>org.utdickinsonlab</groupId>
	<artifactId>NDTiff-FIJI</artifactId>
	<version>0.1</version>

	<name>NDTiff Reader for FIJI</name>
	<description>Opens Micro-Manager NDTiff files in FIJI</description>
	<url>https://www.github.com/dickinson-lab/</url>
	<inceptionYear>2017</inceptionYear>
	<organization>
		<name>Dickinson Lab, University of Texas at Austin</name>
		<url>https://www.utdickinsonlab.org</url>
	</organization>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit/</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<mailingLists>
		<mailingList>
			<name>N/A</name>
		</mailingList>
	</mailingLists>

	<developers>
		<developer>
			<id>dickinson-lab</id>
			<name>Daniel Dickinson</name>
			<url>https://www.github.com/dickinson-lab</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>None</name>
		</contributor>
	</contributors>

	<scm>
		<connection>scm:git:git://github.com/scifio/example-scifio-format</connection>
		<developerConnection>scm:git:git@github.com/scifio/example-scifio-format</developerConnection>
		<tag>HEAD</tag>
		<url>http://github.com/scifio/example-scifio-format</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/scifio/example-scifio-format/issues</url>
	</issueManagement>
	<ciManagement>
		<system>N/A</system>
	</ciManagement>

	<properties>
		<!--
		NB: We override these properties to make the enforcer happy.
		You will need to override them in your POM, too... to valid values.
		-->
		<license.licenseName>N/A</license.licenseName>
		<license.copyrightOwners>N/A</license.copyrightOwners>
	</properties>


	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!--
		scifio/scijava-common/imagej-common are already bundled inside every
		real Fiji install (see PROGRESS.md - copying a second set of these in
		risks duplicate-class conflicts). `provided` scope keeps them on the
		compile/test classpath (needed to build and run this project's own
		tests) without pulling them into the shaded distribution jar below.
		-->
		<dependency>
			<groupId>io.scif</groupId>
			<artifactId>scifio</artifactId>
			<scope>provided</scope>
			<exclusions>
				<exclusion>
					<groupId>io.scif</groupId>
					<artifactId>scifio-jai-imageio</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej-common</artifactId>
			<scope>provided</scope>
		</dependency>

		<!--
		Real NDTiff reading. NDTiffStorage depends on MMCoreJ only for the
		plain-data TaggedImage/JSONObject classes it uses as its pixel+metadata
		carrier - no native/JNI code is loaded unless something actually
		instantiates CMMCore, which this plugin never does. Fiji does not
		bundle either of these, so they stay at the default `compile` scope
		and get packaged into the shaded distribution jar below.
		-->
		<dependency>
			<groupId>org.micro-manager.ndtiffstorage</groupId>
			<artifactId>NDTiffStorage</artifactId>
			<version>2.18.4</version>
		</dependency>
		<dependency>
			<groupId>org.micro-manager.mmcorej</groupId>
			<artifactId>MMCoreJ</artifactId>
			<version>10.1.1.0</version>
		</dependency>

		<!-- Test scope dependencies -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-enforcer-plugin</artifactId>
				<configuration>
					<rules>
						<requireReleaseDeps>
							<!--
							HACK: Tutorials are typically not released and thus are
							SNAPSHOT coupled. So, we effectively disable this test.
							-->
							<onlyWhenRelease>true</onlyWhenRelease>
						</requireReleaseDeps>
					</rules>
				</configuration>
			</plugin>

			<!--
			Bundles the non-Fiji dependencies (NDTiffStorage, MMCoreJ) directly
			into target/NDTiff-FIJI-<version>.jar, so distributing this plugin to
			another machine is a single-file copy into Fiji's jars/ folder
			instead of three. scifio/scijava-common/imagej-common are `provided`
			scope above specifically so the shade plugin's default behavior
			(bundle everything that isn't provided/test scope) leaves them out -
			Fiji already has compatible versions of those, and a second copy
			risks duplicate-class conflicts (see PROGRESS.md).
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>